#!/bin/bash
set -euo pipefail

# Explicit opt-in: this records about four seconds from the default or
# remembered camera and microphone, with a pause, and keeps the clip.
root="$(cd "$(dirname "$0")/.." && pwd)"
"$root/bin/build"
QT_QPA_PLATFORM=offscreen QT_QPA_PLATFORMTHEME= exec "$root/build/camera_check"
