#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BUILD_DIR="$ROOT/build"

. "$ROOT/bin/qt-env"

if command -v nproc >/dev/null 2>&1; then
  JOBS="$(nproc)"
elif command -v sysctl >/dev/null 2>&1; then
  JOBS="$(sysctl -n hw.ncpu 2>/dev/null || echo 1)"
else
  JOBS=1
fi

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

"$QMAKE" "QMAKE_PKG_CONFIG=$PKG_CONFIG" "$ROOT/monologue.pro"
make -j"$JOBS"

echo "Built $BUILD_DIR/monologue"
